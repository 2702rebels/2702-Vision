function(add_libcamera_to_target_sys targetname is_private)
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(libcamera REQUIRED IMPORTED_TARGET libcamera)
    if(is_private EQUAL TRUE)
        target_link_libraries(${targetname} PRIVATE PkgConfig::libcamera)
        target_include_directories(${targetname} PRIVATE ${libcamera_INCLUDE_DIRS})
    else ()
        target_link_libraries(${targetname} PRIVATE PkgConfig::libcamera)
        target_include_directories(${targetname} PRIVATE ${libcamera_INCLUDE_DIRS})
    endif ()
endfunction()

add_package_finder("libcamera" "add_libcamera_to_target_sys" "add_libcamera_to_target_sys")