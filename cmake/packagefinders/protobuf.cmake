function(add_protobuf_to_target_from_vcpkg targetname is_private)
    find_package(protobuf CONFIG REQUIRED)
    if(is_private EQUAL TRUE)
        target_link_libraries(${targetname} PRIVATE protobuf::libprotoc protobuf::libprotobuf protobuf::libprotobuf-lite)
    else ()
        target_link_libraries(${targetname} PUBLIC protobuf::libprotoc protobuf::libprotobuf protobuf::libprotobuf-lite)
    endif ()
endfunction()

function(add_protobuf_to_target_from_sys targetname is_private)
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(protobuf REQUIRED IMPORTED_TARGET protobuf)
    if(is_private EQUAL TRUE)
        target_link_libraries(${targetname} PRIVATE PkgConfig::protobuf)
    else ()
        target_link_libraries(${targetname} PUBLIC PkgConfig::protobuf)
    endif ()
endfunction()

add_package_finder("protobuf" "add_protobuf_to_target_from_vcpkg" "add_protobuf_to_target_from_sys")