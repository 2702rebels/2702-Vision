function(add_wpilib_to_target_from_vcpkg targetname is_private)
    if(is_private EQUAL TRUE)
        add_package_to_target("protobuf" "${targetname}" TRUE)
    else ()
        add_package_to_target("protobuf" "${targetname}" FALSE)
    endif ()

    find_package(Threads REQUIRED)
    if(is_private EQUAL TRUE)
        target_link_libraries(${targetname} PRIVATE Threads::Threads)
    else ()
        target_link_libraries(${targetname} PUBLIC Threads::Threads)
    endif ()

    find_package(fmt CONFIG REQUIRED)
    if(is_private EQUAL TRUE)
        target_link_libraries(${targetname} PRIVATE fmt::fmt)
    else ()
        target_link_libraries(${targetname} PUBLIC fmt::fmt)
    endif ()
    if(CMAKE_BUILD_TYPE STREQUAL "Debug")
        set(LIB_SUFFIX "d")
    else ()
        set(LIB_SUFFIX "")
    endif ()

    find_package(libuv CONFIG REQUIRED)
    if(is_private EQUAL TRUE)
        target_link_libraries(${targetname} PRIVATE $<IF:$<TARGET_EXISTS:libuv::uv_a>,libuv::uv_a,libuv::uv>)
    else ()
        target_link_libraries(${targetname} PUBLIC $<IF:$<TARGET_EXISTS:libuv::uv_a>,libuv::uv_a,libuv::uv>)
    endif ()

    set(WPI_PACKAGES "cameraserver" "cscore" "ntcore" "wpilibc" "wpilibNewCommands" "wpimath" "wpinet" "wpiutil")
    foreach (wpi_package IN LISTS WPI_PACKAGES)
        if(is_private EQUAL TRUE)
            target_include_directories(${targetname} PRIVATE "${CMAKE_BINARY_DIR}/vcpkg_installed/${VCPKG_TARGET_TRIPLET}/include/${wpi_package}")
        else ()
            target_include_directories(${targetname} PUBLIC "${CMAKE_BINARY_DIR}/vcpkg_installed/${VCPKG_TARGET_TRIPLET}/include/${wpi_package}")
        endif ()
        if(CMAKE_BUILD_TYPE STREQUAL "Release")
            if(is_private EQUAL TRUE)
                target_link_directories(${targetname} PRIVATE "${CMAKE_BINARY_DIR}/vcpkg_installed/${VCPKG_TARGET_TRIPLET}/lib")
            else ()
                target_link_directories(${targetname} PUBLIC "${CMAKE_BINARY_DIR}/vcpkg_installed/${VCPKG_TARGET_TRIPLET}/lib")
            endif ()
        else ()
            if(is_private EQUAL TRUE)
                target_link_directories(${targetname} PRIVATE "${CMAKE_BINARY_DIR}/vcpkg_installed/${VCPKG_TARGET_TRIPLET}/debug/lib")
            else ()
                target_link_directories(${targetname} PUBLIC "${CMAKE_BINARY_DIR}/vcpkg_installed/${VCPKG_TARGET_TRIPLET}/debug/lib")
            endif ()
        endif ()
        if(is_private EQUAL TRUE)
            target_link_libraries(${targetname} PRIVATE ${wpi_package}${LIB_SUFFIX})
        else ()
            target_link_libraries(${targetname} PUBLIC ${wpi_package}${LIB_SUFFIX})
        endif ()
    endforeach ()
endfunction()

function(add_wpilib_to_target_from_sys targetname is_private)
    find_package(wpilib REQUIRED)
    if(is_private EQUAL TRUE)
        target_link_libraries(${targetname} PRIVATE wpilibNewCommands wpilibc cameraserver cscore ntcore wpinet wpimath wpiutil)
    else ()
        target_link_libraries(${targetname} PUBLIC wpilibNewCommands wpilibc cameraserver cscore ntcore wpinet wpimath wpiutil)
    endif ()
endfunction()

add_package_finder("wpilib" "add_wpilib_to_target_from_vcpkg" "add_wpilib_to_target_from_sys")