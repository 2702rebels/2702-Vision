function(add_gtest_to_target_vcpkg targetname is_private)
    find_package(GTest CONFIG REQUIRED)
    include(GoogleTest)
    if(is_private EQUAL TRUE)
        target_link_libraries(${targetname} PRIVATE GTest::gtest)
    else ()
        target_link_libraries(${targetname} PUBLIC GTest::gtest)
    endif ()
endfunction()

function(add_gtest_to_target_sys targetname is_private)
    find_package(GTest REQUIRED)
    include(GoogleTest)
    if(is_private EQUAL TRUE)
        target_link_libraries(${targetname} PRIVATE gtest)
    else ()
        target_link_libraries(${targetname} PRIVATE gtest)
    endif ()
endfunction()

add_package_finder("gtest" "add_gtest_to_target_vcpkg" "add_gtest_to_target_sys")