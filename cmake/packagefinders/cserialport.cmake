function(add_cserialport_to_target_vcpkg targetname is_private)
    find_package(CSerialPort REQUIRED)
    if(is_private EQUAL TRUE)
        target_include_directories(${targetname} PRIVATE ${CSerialPort_INCLUDE_DIR})
        target_link_libraries (${targetname} PRIVATE ${CSerialPort_LIBRARY})
    else()
        target_include_directories(${targetname} PUBLIC ${CSerialPort_INCLUDE_DIR})
        target_link_libraries (${targetname} PUBLIC ${CSerialPort_LIBRARY})
    endif ()
endfunction()

