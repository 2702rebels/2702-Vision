function(add_spdlog_to_target_vcpkg targetname is_private)
    find_package(spdlog CONFIG REQUIRED)
    if(is_private EQUAL TRUE)
        target_link_libraries(${targetname} PRIVATE spdlog::spdlog)
    else ()
        target_link_libraries(${targetname} PUBLIC spdlog::spdlog)
    endif ()
endfunction()

function(add_spdlog_to_target_sys targetname is_private)
    find_package(spdlog REQUIRED)
    if(is_private EQUAL TRUE)
        target_include_directories(${targetname} PRIVATE ${spdlog_INCLUDE_DIRS})
        target_link_libraries(${targetname} PRIVATE ${spdlog_LIBS})
    else ()
        target_include_directories(${targetname} PUBLIC ${spdlog_INCLUDE_DIRS})
        target_link_libraries(${targetname} PUBLIC ${spdlog_LIBS})
    endif ()
endfunction()

add_package_finder("spdlog" "add_spdlog_to_target_vcpkg" "add_spdlog_to_target_sys")