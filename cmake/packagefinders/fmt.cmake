function(add_fmt_to_target_vcpkg targetname is_private)
    find_package(fmt CONFIG REQUIRED)
    if(is_private EQUAL TRUE)
        target_link_libraries(${targetname} PRIVATE fmt::fmt)
    else ()
        target_link_libraries(${targetname} PUBLIC fmt::fmt)
    endif ()
endfunction()

function(add_fmt_to_target_sys targetname is_private)
    find_package(fmt CONFIG REQUIRED)
    if(is_private EQUAL TRUE)
        target_link_libraries(${targetname} PRIVATE fmt::fmt)
    else ()
        target_link_libraries(${targetname} PUBLIC fmt::fmt)
    endif ()
endfunction()

add_package_finder("fmt" "add_fmt_to_target_vcpkg" "add_fmt_to_target_sys")