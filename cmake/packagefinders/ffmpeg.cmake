function(add_ffmpeg_to_target_sys targetname is_private)
    find_package(FFMPEG REQUIRED)
    if(is_private EQUAL TRUE)
        target_include_directories(${targetname} PRIVATE ${FFMPEG_INCLUDE_DIRS})
        target_link_directories(${targetname} PRIVATE ${FFMPEG_LIBRARY_DIRS})
        target_link_libraries(${targetname} PRIVATE ${FFMPEG_LIBRARIES})
    else ()
        target_include_directories(${targetname} PUBLIC ${FFMPEG_INCLUDE_DIRS})
        target_link_directories(${targetname} PUBLIC ${FFMPEG_LIBRARY_DIRS})
        target_link_libraries(${targetname} PUBLIC ${FFMPEG_LIBRARIES})
    endif ()
endfunction()

add_package_finder("ffmpeg" "add_ffmpeg_to_target_sys" "add_ffmpeg_to_target_sys")