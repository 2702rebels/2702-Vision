string(FIND "${CMAKE_TOOLCHAIN_FILE}" "vcpkg.cmake" vcpkgToolchainIndex)
if(vcpkgToolchainIndex EQUAL -1)
    set(USING_VCPKG FALSE)
    set(USING_SYS TRUE)
    message(STATUS "Using sys as package source")
else ()
    set(USING_SYS FALSE)
    set(USING_VCPKG TRUE)
    message(STATUS "Using vcpkg as package source")
    set(VCPKG_DIR "${CMAKE_SOURCE_DIR}/vcpkg")
    message(STATUS "Deleting vcpkg leftovers from vcpkg root directory ${VCPKG_DIR}")
    file(REMOVE_RECURSE "${VCPKG_DIR}/buildtrees")
    file(REMOVE_RECURSE "${VCPKG_DIR}/packages")
    file(REMOVE_RECURSE "${CMAKE_SOURCE_DIR}/vcpkg_installed")
    message(STATUS "Finished deleting vcpkg leftovers")
endif ()

function(add_package_finder packagename target_append_fun_vcpkg_name target_append_fun_sys_name)
    list(APPEND PACKAGE_NAMES ${packagename})
    list(APPEND PACKAGE_TARGET_APPEND_VCPKG_FUN ${target_append_fun_vcpkg_name})
    list(APPEND PACKAGE_TARGET_APPEND_SYS_FUN ${target_append_fun_sys_name})
    # Make the package names var not local scope
    set(PACKAGE_NAMES ${PACKAGE_NAMES} PARENT_SCOPE)
    set(PACKAGE_TARGET_APPEND_VCPKG_FUN ${PACKAGE_TARGET_APPEND_VCPKG_FUN} PARENT_SCOPE)
    set(PACKAGE_TARGET_APPEND_SYS_FUN ${PACKAGE_TARGET_APPEND_SYS_FUN} PARENT_SCOPE)
endfunction()

function(add_package_to_target packagename targetname is_private)
    list(FIND PACKAGE_NAMES ${packagename} index)
    if(index EQUAL -1)
        message(FATAL_ERROR "Failed to find ${packagename} in the list of register targets when trying to find it for target ${targetname}")
    endif ()
    if(USING_SYS)
        list(GET PACKAGE_TARGET_APPEND_SYS_FUN ${index} SYS_FUN)
        cmake_language(CALL ${SYS_FUN} ${targetname} ${is_private})
    endif ()
    if(USING_VCPKG)
        list(GET PACKAGE_TARGET_APPEND_VCPKG_FUN ${index} VCPKG_FUN)
        cmake_language(CALL ${VCPKG_FUN} ${targetname} ${is_private})
    endif ()
endfunction()