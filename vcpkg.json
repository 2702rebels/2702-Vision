{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "2702vision",
  "description": "The 2702 Vision object detection / apriltag system.",
  "dependencies": [
    "asio",
    {
      "name": "ffmpeg",
      "features": [
        "avcodec",
        "avdevice",
        "avfilter",
        "avformat",
        "avresample",
        "ffmpeg"
      ]
    },
    "gtest",
    {
      "name": "libcamera",
      "platform": "linux"
    },
    {
      "name": "opencv4",
      "features": [
        "calib3d",
        "highgui",
        {
          "name": "dshow",
          "platform": "windows & !uwp"
        },
        "ffmpeg",
        {
          "name": "msmf",
          "platform": "windows & !uwp & !mingw"
        },
        "jpeg",
        "jpegxl",
        "opencl",
        "openexr",
        "openjpeg",
        "openmp",
        "png"
      ]
    },
    "protobuf",
    "pthread",
    "spdlog",
    {
      "name": "wpilib",
      "features": [
        "ntcore",
        "protobuf",
        "cameraserver",
        "wpimath",
        "allwpilib"
      ]
    },
    "cserialport",
    "nlohmann-json"
  ]
}
