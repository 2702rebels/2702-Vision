{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "2702vision",
  "description": "The 2702 Vision object detection / apriltag system.",
  "dependencies": [
    "asio",
    {
      "name": "ffmpeg",
      "features": [
        "ffmpeg",
        "ffprobe"
      ]
    },
    "gtest",
    {
      "name": "libcamera",
      "platform": "linux"
    },
    "nlohmann-json",
    {
      "name": "opencv4",
      "features": [
        "ade",
        "aravis",
        "calib3d",
        "contrib",
        "eigen",
        "ffmpeg",
        "freetype",
        "fs",
        "gapi",
        "gstreamer",
        {
          "name": "gtk",
          "platform": "!windows & !osx & !ios & !android"
        },
        "highgui",
        "intrinsics",
        "ipp",
        "jpeg",
        "jpegxl",
        "nonfree",
        "opencl",
        "opengl",
        "openjpeg",
        "openmp",
        "png",
        "python",
        "quirc",
        "thread",
        "tiff",
        "vulkan",
        "webp"
      ]
    },
    "pthread",
    "spdlog",
    {
      "name": "wpilib",
      "features": [
        "cscore",
        "protobuf"
      ]
    }
  ]
}
